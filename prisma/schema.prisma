generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  role                UserRole  @default(USER)
  image               String?
  profileCompleted    Boolean   @default(false)
  isBanned            Boolean   @default(false)
  banReason           String?
  // Solo afecta a administradores: si está en false, este admin no recibe
  // los correos de notificación cuando se crea una nueva solicitud. Por
  // defecto está en true para mantener el comportamiento anterior.
  receiveAdminEmails  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  lastLogin           DateTime?

  accounts     Account[]
  sessions     Session[]
  reservations Reservation[] @relation("UserReservations")
  reviewed     Reservation[] @relation("ReviewedBy")
  blockedSlots BlockedSlot[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model Space {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  description   String?
  capacity      Int
  floor         Int?
  building      String    @default("IUCE")
  equipment     Json      @default("[]")
  accessibility Boolean   @default(false)
  color         String    @default("#3B7DD8")
  imageUrl      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reservations Reservation[]
  blockedSlots BlockedSlot[]

  @@index([isActive])
  @@index([building])
}

model Reservation {
  id                String            @id @default(cuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  status            ReservationStatus @default(PENDING)
  attendees         Int               @default(1)
  adminNotes        String?
  reviewedAt        DateTime?
  isRecurring       Boolean           @default(false)
  recurrenceRule    String?
  recurrenceGroupId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  userId       String
  user         User   @relation("UserReservations", fields: [userId], references: [id], onDelete: Cascade)
  spaceId      String
  space        Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   User?  @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([userId, status])
  @@index([spaceId, startTime, endTime])
  @@index([status])
  @@index([startTime])
  @@index([recurrenceGroupId])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  reason    String
  createdAt DateTime @default(now())

  spaceId     String
  space       Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([spaceId, startTime, endTime])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  userId     String
  targetType String
  targetId   String
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
